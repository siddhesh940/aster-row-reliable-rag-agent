# Aster & Row support agent — environment configuration
#
# The agent runs fully offline by default (deterministic grounded composer,
# local TF-IDF retrieval). Copy this file to `.env` and fill in values only if
# you want LLM-phrased answers on top of the deterministic pipeline.
#
# NEVER put real credentials in this file or commit `.env`.

# --- Optional LLM phrasing layer (OpenAI-compatible chat completions API) ---
# When ALL three are set, the agent phrases final answers via the model using
# a strict grounded system prompt. Tool calls, precedence, conflict detection,
# and abstention stay deterministic in code regardless of these settings.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=45

# --- Agent behavior ----------------------------------------------------------
# full  : precedence filtering + conflict detection + context resolution
# naive : baseline profile used for the baseline evaluation in the README
AGENT_PROFILE=full

# Print sanitized debug traces after every turn (also toggled with --debug)
AGENT_DEBUG=0
